{
  "name": "@backtrail/cli",
  "version": "0.1.0",
  "description": "",
  "license": "MIT",
  "type": "module",
  "bin": {
    "backtrail": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.14",
    "npm": ">=11"
  },
  "imports": {
    "#/*": "./src/*.ts"
  },
  "scripts": {
    "prebuild": "pnpm typecheck",
    "build": "tsdown",
    "build:watch": "pnpm build --watch",
    "typecheck": "tsc --noEmit",
    "dev": "concurrently --kill-others-on-fail --names build,types \"pnpm build:watch\" \"pnpm build:typecheck --watch --preserveWatchOutput\"",
    "start": "pnpm start:dev",
    "start:dev": "node --watch dist/main.js",
    "start:prod": "node dist/main.js",
    "release:prepare": "pnpm test && pnpm build --publint",
    "prepublishOnly": "pnpm release:prepare",
    "release:publish": "pnpm publish",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "24.6.1",
    "concurrently": "9.2.1",
    "publint": "0.3.21",
    "tsdown": "0.22.0-beta.3",
    "typescript": "catalog:",
    "vitest": "4.1.6"
  },
  "dependencies": {
    "@clack/prompts": "1.4.0",
    "commander": "14.0.3",
    "zod": "4.4.3"
  }
}